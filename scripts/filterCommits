import json, re

IN = "commits_raw.jsonl"
OUT = "commits_filtered.jsonl"

commits = [json.loads(l) for l in open(IN, encoding="utf-8")]

FUNNEL = [
    # Done by bots
    ("wpt import", lambda c: "[wpt PR" in c["subject"]),

    #  undoing patches 
    ("backout", lambda c: re.match(r"(backed out|back out|revert)", c["subject"], re.I)),

    # third-party code)
    ("Third-Party", lambda c: re.search(r"vendor .* from|cherry-pick upstream", c["subject"], re.I)),

    ("no bug ID", lambda c: not re.search(r"bug ?\d+", c["subject"], re.I)),
]



kept = commits
for name, test in FUNNEL:
    survivors = []
    removed = 0
    for commit in kept:
        if test(commit):
            removed += 1
        else:
            survivors.append(commit)
    kept = survivors
    print(f"{name} -{removed:<6} {len(kept):>6}")
 
with open(OUT, "w", encoding="utf-8") as f:
    f.writelines(json.dumps(c, ensure_ascii=False) + "\n" for c in kept)
 
print(f"\n{len(kept)} commits -> {OUT}")
